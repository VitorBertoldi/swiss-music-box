{
  "$defs": {
    "LeadIn": {
      "additionalProperties": false,
      "description": "The track behind the start of a run, where a waiting train's rear cars stand.",
      "properties": {
        "coordinates": {
          "description": "Flat [longitude, latitude, ...] in travel order, ending where the run starts",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "heights_dm": {
          "description": "Height per point, in decimetres",
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "coordinates",
        "heights_dm"
      ],
      "title": "LeadIn",
      "type": "object"
    },
    "Legs": {
      "additionalProperties": false,
      "description": "Column-wise: leg i travels `segments[segment[i]]` (backwards if `reversed`).",
      "properties": {
        "segment": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "reversed": {
          "items": {
            "type": "boolean"
          },
          "type": "array"
        },
        "depart_minute": {
          "description": "May exceed 1440 for trips past midnight",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "arrive_minute": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "lead_in": {
          "description": "Index into Motion.lead_ins where this leg starts a run (the trip's first leg, after a reversal or a gap), else -1",
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "segment",
        "reversed",
        "depart_minute",
        "arrive_minute",
        "lead_in"
      ],
      "title": "Legs",
      "type": "object"
    },
    "Pylon": {
      "additionalProperties": false,
      "description": "A ropeway pylon (`aerialway=pylon`) on a rope in use: where it stands and how high.",
      "properties": {
        "longitude": {
          "type": "number"
        },
        "latitude": {
          "type": "number"
        },
        "base_dm": {
          "description": "Height of the ground at its foot, in decimetres",
          "type": "integer"
        },
        "top_dm": {
          "description": "Height of its top, where the rope runs, in decimetres",
          "type": "integer"
        }
      },
      "required": [
        "longitude",
        "latitude",
        "base_dm",
        "top_dm"
      ],
      "title": "Pylon",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "description": "The path between two consecutive stops, shared by every trip that uses it.",
      "properties": {
        "coordinates": {
          "description": "Flat [longitude, latitude, ...]; OSM geometry with redundant points removed",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "heights_dm": {
          "description": "Height above sea level per point of `coordinates`, in decimetres",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "overview_coordinates": {
          "description": "The same path simplified to 15 m, for country-wide views",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "length_m": {
          "description": "Length along the network",
          "type": "integer"
        },
        "route": {
          "description": "How the path was found",
          "enum": [
            "track",
            "ferry_route",
            "rope",
            "straight"
          ],
          "type": "string"
        },
        "ropeway": {
          "anyOf": [
            {
              "enum": [
                "cable_car",
                "gondola",
                "chair_lift"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a rope: what hangs from it (heights are the rope's), else null"
        },
        "tunnels": {
          "items": {
            "$ref": "#/$defs/TunnelPassage"
          },
          "type": "array"
        }
      },
      "required": [
        "coordinates",
        "heights_dm",
        "overview_coordinates",
        "length_m",
        "route",
        "ropeway",
        "tunnels"
      ],
      "title": "Segment",
      "type": "object"
    },
    "Trips": {
      "additionalProperties": false,
      "description": "Column-wise: trip i has `layer[i]` and legs `first_leg[i] .. first_leg[i]+leg_count[i]`.",
      "properties": {
        "layer": {
          "items": {
            "enum": [
              "long_rail",
              "mountain_rail",
              "regional_rail",
              "boat",
              "aerial",
              "funicular"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "first_leg": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "leg_count": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "layer",
        "first_leg",
        "leg_count"
      ],
      "title": "Trips",
      "type": "object"
    },
    "Tunnel": {
      "additionalProperties": false,
      "description": "A long tunnel found in OpenStreetMap (`tunnel=yes` on rail ways).",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "description": "OSM name, or 'Tunnel near <station>' when OSM has none",
          "type": "string"
        },
        "length_m": {
          "type": "integer"
        },
        "coordinates": {
          "description": "Flat [longitude, latitude, ...] of its axis",
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "length_m",
        "coordinates"
      ],
      "title": "Tunnel",
      "type": "object"
    },
    "TunnelPassage": {
      "additionalProperties": false,
      "description": "The part of a segment that runs inside a tunnel, as fractions of the segment length.",
      "properties": {
        "tunnel": {
          "description": "Index into Motion.tunnels",
          "type": "integer"
        },
        "start_fraction": {
          "type": "number"
        },
        "end_fraction": {
          "type": "number"
        }
      },
      "required": [
        "tunnel",
        "start_fraction",
        "end_fraction"
      ],
      "title": "TunnelPassage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "How every moving vehicle travels on one service day.",
  "properties": {
    "schema_version": {
      "const": 4,
      "default": 4,
      "type": "integer"
    },
    "service_date": {
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "type": "array"
    },
    "trips": {
      "$ref": "#/$defs/Trips"
    },
    "legs": {
      "$ref": "#/$defs/Legs"
    },
    "lead_ins": {
      "items": {
        "$ref": "#/$defs/LeadIn"
      },
      "type": "array"
    },
    "pylons": {
      "items": {
        "$ref": "#/$defs/Pylon"
      },
      "type": "array"
    },
    "tunnels": {
      "items": {
        "$ref": "#/$defs/Tunnel"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "service_date",
    "segments",
    "trips",
    "legs",
    "lead_ins",
    "pylons",
    "tunnels"
  ],
  "title": "Motion",
  "type": "object"
}
